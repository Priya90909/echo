NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://localhost:27017/echo
REDIS_URL=redis://localhost:6379
# Replace with at least 32 random characters. Never use this example in production.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=echo
S3_ACCESS_KEY=echo-local
S3_SECRET_KEY=echo-local-development-only
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Optional Google OAuth; callback uses the same public origin as the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback
