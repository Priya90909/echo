{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @echo/api\" \"npm run dev -w @echo/web\"",
    "build": "npm run build -w @echo/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
